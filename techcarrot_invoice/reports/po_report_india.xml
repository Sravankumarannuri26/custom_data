<odoo>
    <template id="report_po_india_document">
        <t t-call="web.basic_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang, use_delivery_as_company_address=True)"/>

            <!-- ================= CUSTOM HEADER ================= -->
            <!-- Replaces what web.external_layout used to render automatically -->
            <div class="header" style="border-bottom: 1px solid #ddd;  margin-bottom: 0; line-height: 1.15; font-size: 11px;">
                <div class="row">
                    <div class="col-6">
                        <img t-if="o.company_id.logo"
                             t-att-src="image_data_uri(o.company_id.logo)"
                             style="max-height: 45px;"/>
                        <div>
<!--                            <strong t-field="o.company_id.name"/>-->
                            <strong >techcarrot India Private Limited</strong>
                            <div t-field="o.deliver_partner_id"
                                 t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            <div t-if="o.deliver_partner_id.vat">
                                TRN <span t-field="o.deliver_partner_id.vat"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 text-end">
                        <h4 class="m-0">
                            <span t-if="o.state in ['draft', 'sent', 'to approve']">Request for Quotation #</span>
                            <span t-if="o.state == 'purchase'">Purchase Order #</span>
                            <span t-if="o.state == 'cancel'">Cancelled Purchase Order #</span>
                            <span t-field="o.name"/>
                        </h4>
                    </div>
                </div>
            </div>

            <!-- ================= BODY ================= -->
            <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
                 t-att-data-oe-lang="o and o.env.context.get('lang')">
                <div class="page" style="padding-top: 200px">
                    <div class="oe_structure"/>

                    <!-- Address block: Delivery on the left, Vendor on the right -->
                    <div class="row mb-4">
                        <div class="col-6" t-if="o.deliver_partner_id">
                            <strong class="d-block mt-3">Delivery address</strong>
                            <div t-field="o.deliver_partner_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'
                                 name="purchase_shipping_address"/>
                        </div>
                        <div class="col-6">
                            <strong class="d-block mt-3">Vendor address</strong>
                            <div t-field="o.partner_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>
                        </div>
                    </div>

                    <div id="informations" class="row mb-4">
                        <div t-if="o.user_id" class="col">
                            <strong>Buyer</strong>
                            <div t-field="o.user_id"/>
                        </div>
                        <div t-if="o.partner_ref" class="col">
                            <strong>Your Order Reference</strong>
                            <div t-field="o.partner_ref"/>
                        </div>
                        <div t-if="o.state == 'purchase' and o.date_approve" class="col-3 bm-2">
                            <strong>Order Date:</strong>
                            <p t-field="o.date_approve" t-options="{'date_only': 'true'}" class="m-0"/>
                        </div>
                        <div t-elif="o.date_order" class="col-2 bm-2">
                            <strong>Order Deadline:</strong>
                            <p t-field="o.date_order" t-options="{'date_only': 'true'}" class="m-0"/>
                        </div>
                        <div t-if="o.date_planned" class="col-2 bm-2">
                            <strong>Expected Arrival:</strong>
                            <p t-field="o.date_planned" t-options="{'date_only': 'true'}" class="m-0"/>
                        </div>
                    </div>

                    <table class="o_has_total_table table o_main_table" style="border-collapse: collapse; border: 1px solid #333;">
                        <thead style="display: table-row-group">
                            <tr>
                                <th name="th_description" class="text-start" style="border: 1px solid #333; padding: 4px 6px;"><strong>Description</strong></th>
                                <th name="th_quantity" class="text-end" style="border: 1px solid #333; padding: 4px 6px;"><strong>Qty</strong></th>
                                <th name="th_price_unit" class="text-end" style="border: 1px solid #333; padding: 4px 6px;"><strong>Unit Price</strong></th>
                                <th name="th_discount" class="text-end" style="border: 1px solid #333; padding: 4px 6px;"><strong>Disc.</strong></th>
                                <th name="th_taxes" class="text-end" style="border: 1px solid #333; padding: 4px 6px;"><strong>Taxes</strong></th>
                                <th name="th_subtotal" class="text-end" style="border: 1px solid #333; padding: 4px 6px;"><strong>Amount</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="current_subtotal" t-value="0"/>
                            <t t-foreach="o.order_line.filtered(lambda l: l.display_type or l.product_qty != 0)"
                               t-as="line">
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                                <tr t-att-class="'fw-bolder o_line_section' if line.display_type == 'line_section' else 'fw-bold o_line_subsection' if line.display_type == 'line_subsection' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                    <t t-if="not line.display_type">
                                        <td id="product" class="text-start" style="border: 1px solid #333; padding: 4px 6px;">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td class="text-end" style="border: 1px solid #333; padding: 4px 6px;">
                                            <span t-field="line.product_qty"/>
                                            <span t-field="line.product_uom_id.name" groups="uom.group_uom"/>
                                            <span t-if="line.product_uom_id != line.product_id.uom_id"
                                                  class="text-muted small">
                                                <br/>
                                                <span t-field="line.product_uom_qty"
                                                      t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
                                                <span t-field="line.product_id.uom_id"/>
                                            </span>
                                        </td>
                                        <td class="text-end" style="border: 1px solid #333; padding: 4px 6px;">
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <td class="text-end" style="border: 1px solid #333; padding: 4px 6px;">
                                            <span class="text-align-bottom"><span t-field="line.discount"/>%</span>
                                        </td>
                                        <td class="text-end" style="border: 1px solid #333; padding: 4px 6px;">
                                            <span t-out="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/>
                                        </td>
                                        <td class="text-end" style="border: 1px solid #333; padding: 4px 6px;">
                                            <span t-field="line.price_subtotal"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </t>
                                    <t t-if="line.display_type in ('line_section', 'line_subsection')">
                                        <td colspan="99" id="section" style="border: 1px solid #333; padding: 4px 6px;">
                                            <span t-field="line.name"/>
                                        </td>
                                        <t t-set="current_section" t-value="line"/>
                                        <t t-set="current_subtotal" t-value="0"/>
                                    </t>
                                    <t t-if="line.display_type == 'line_note'">
                                        <td colspan="99" id="note" style="border: 1px solid #333; padding: 4px 6px;">
                                            <span t-field="line.name"/>
                                        </td>
                                    </t>
                                </tr>
                                <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type in ('line_section', 'line_subsection'))">
                                    <tr class="is-subtotal text-end">
                                        <td colspan="99" id="subtotal" style="border: 1px solid #333; padding: 4px 6px;">
                                            <strong class="mr16">Subtotal</strong>
                                            <span t-out="current_subtotal"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <div id="total" class="row justify-content-end mt-n3">
                        <div class="col-4">
                            <table class="o_total_table table table-borderless">
                                <t t-call="purchase.document_tax_totals">
                                    <t t-set="tax_totals" t-value="o.tax_totals"/>
                                    <t t-set="currency" t-value="o.currency_id"/>
                                </t>
                            </table>
                        </div>
                    </div>

                    <p t-field="o.note" class="mt-4"/>
                    <div class="oe_structure"/>

                    <strong>Payment Terms:</strong>
                    <span t-field="o.payment_term_id" class="mt-4"/>

                    <t t-set="base_address" t-value="o.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>
                    <t t-set="portal_url"
                       t-value="base_address + '/my/purchase/' + str(o.id) + '#portal_connect_software_modal'"/>
                    <div t-if="any(u._is_portal() for u in o.partner_id.user_ids) and o._get_edi_builders()"
                         class="text-center">
                        <a t-att-href="portal_url">Connect your software</a>
                        with
                        <t t-out="o.company_id.name"/>
                        to create quotes automatically.
                    </div>
                </div>
            </div>

            <!-- ================= CUSTOM FOOTER ================= -->
            <div class="footer o_standard_footer" style="border-top: 1px solid #ddd; padding: 6px 12mm 0 12mm; font-size: 10px;">
                <div class="row">
                    <div class="col-8">
                        <span t-field="o.company_id.name"/>
                        <span t-if="o.company_id.phone"> | <span t-field="o.company_id.phone"/></span>
                        <span t-if="o.company_id.email"> | <span t-field="o.company_id.email"/></span>
                    </div>
                    <div class="col-4 text-end">
                        Page <span class="page"/> / <span class="topage"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_po_india">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="techcarrot_invoice.report_po_india_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!--  ============================================================
             PAPER FORMAT: reserves enough top margin for the taller
             custom header (logo + company address + TRN). This is what
             actually fixes the header/body overlap - wkhtmltopdf gives
             the fixed header exactly (margin_top - header_spacing) mm
             of height and then starts the body right after it, no
             matter how tall the header content really is.
             ============================================================  -->
    <record id="paperformat_po_india" model="report.paperformat">
        <field name="name">PO India Paperformat</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <!--  ============================================================
             REPORT ACTION: separate from the standard PO report so it
             does not touch/override purchase.action_report_purchaseorder
             ============================================================  -->
    <record id="action_report_po_supplier_address" model="ir.actions.report">
        <field name="name">INDIA PO PRINT </field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">techcarrot_invoice.report_po_india</field>
        <field name="report_file">techcarrot_invoice.report_po_india</field>
        <field name="print_report_name">'PO - %s' % (object.name)</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="techcarrot_invoice.paperformat_po_india"/>
    </record>
</odoo>