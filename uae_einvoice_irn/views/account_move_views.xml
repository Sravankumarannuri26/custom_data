<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_irn_button" model="ir.ui.view">
        <field name="name">account.move.form.irn.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_generate_irn"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-code-o"
                        invisible="move_type not in ('out_invoice', 'out_refund')">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">Generate</span>
                        <span class="o_stat_text">IRN</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_irn_payload_preview_form" model="ir.ui.view">
        <field name="name">irn.payload.preview.form</field>
        <field name="model">irn.payload.preview</field>
        <field name="arch" type="xml">
            <form string="IRN Payload">
                <sheet>
                    <group>
                        <field
                                name="json_payload"
                                nolabel="1"
                                readonly="1"
                                widget="text"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
